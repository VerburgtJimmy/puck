---
/**
 * Frosted glass cloud - yellow light trapped inside, no sun.
 * Unified silhouette (not separate bubbles), soft depth, pulsing core.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const uid = Math.random().toString(36).slice(2, 9);
const path =
  'M92 210 C 70 210, 48 188, 52 158 C 28 148, 22 118, 42 98 C 38 70, 58 48, 88 52 C 98 28, 128 18, 154 32 C 172 12, 206 10, 228 30 C 252 14, 288 18, 306 42 C 338 36, 368 56, 370 90 C 398 98, 410 128, 396 152 C 412 172, 402 200, 372 210 Z';
---

<div class:list={['gc', className]} aria-hidden="true">
  <svg class="gc__svg" viewBox="0 0 440 260" role="presentation">
    <defs>
      <linearGradient id={`face-${uid}`} x1="0.2" y1="0" x2="0.55" y2="1">
        <stop offset="0%" stop-color="rgba(255,255,255,0.85)" />
        <stop offset="40%" stop-color="rgba(248,250,252,0.55)" />
        <stop offset="100%" stop-color="rgba(198,214,232,0.4)" />
      </linearGradient>
      <linearGradient id={`rim-${uid}`} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="rgba(255,255,255,0.95)" />
        <stop offset="55%" stop-color="rgba(255,255,255,0.2)" />
        <stop offset="100%" stop-color="rgba(140,165,195,0.55)" />
      </linearGradient>
      <radialGradient id={`core-${uid}`} cx="58%" cy="42%" r="40%">
        <stop offset="0%" stop-color="rgba(255,225,100,0.95)" />
        <stop offset="28%" stop-color="rgba(255,170,50,0.65)" />
        <stop offset="55%" stop-color="rgba(255,120,40,0.28)" />
        <stop offset="100%" stop-color="rgba(255,120,40,0)" />
      </radialGradient>
      <filter id={`soft-${uid}`} x="-20%" y="-20%" width="140%" height="140%">
        <feGaussianBlur stdDeviation="6" />
      </filter>
      <filter id={`glass-${uid}`} x="-5%" y="-5%" width="110%" height="110%">
        <feGaussianBlur in="SourceGraphic" stdDeviation="0.4" result="b" />
        <feMerge>
          <feMergeNode in="b" />
        </feMerge>
      </filter>
      <clipPath id={`clip-${uid}`}>
        <path d={path} />
      </clipPath>
    </defs>

    <!-- soft ground shadow -->
    <ellipse cx="220" cy="238" rx="140" ry="14" fill="rgba(90,115,145,0.22)" filter={`url(#soft-${uid})`} />

    <!-- 3D depth slab -->
    <path d={path} transform="translate(8 12)" fill="rgba(135,160,190,0.32)" />
    <path d={path} transform="translate(4 6)" fill="rgba(175,195,215,0.28)" />

    <!-- opaque soft body -->
    <path d={path} fill="#eef3f8" />

    <!-- trapped yellow (inside) -->
    <g clip-path={`url(#clip-${uid})`}>
      <circle class="gc__core" cx="255" cy="118" r="95" fill={`url(#core-${uid})`} />
      <circle class="gc__core-hot" cx="255" cy="118" r="42" fill="rgba(255,230,120,0.75)" />
    </g>

    <!-- frosted glass face -->
    <path
      d={path}
      fill={`url(#face-${uid})`}
      stroke={`url(#rim-${uid})`}
      stroke-width="2.25"
      filter={`url(#glass-${uid})`}
    />

    <!-- top specular -->
    <g clip-path={`url(#clip-${uid})`}>
      <ellipse cx="150" cy="95" rx="95" ry="28" fill="rgba(255,255,255,0.55)" />
      <ellipse cx="280" cy="130" rx="50" ry="16" fill="rgba(255,255,255,0.18)" />
    </g>
  </svg>
</div>

<style>
  .gc {
    width: 100%;
    filter: drop-shadow(0 22px 28px rgba(90, 120, 155, 0.2));
    animation: gc-float 8s ease-in-out infinite;
  }

  .gc__svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .gc__core {
    animation: gc-breathe 4.8s ease-in-out infinite;
  }

  .gc__core-hot {
    filter: blur(6px);
    transform-origin: 255px 118px;
    animation: gc-pulse 4.8s ease-in-out infinite;
  }

  @keyframes gc-float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 9px;
    }
  }

  @keyframes gc-breathe {
    0%,
    100% {
      opacity: 0.65;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes gc-pulse {
    0%,
    100% {
      opacity: 0.35;
      transform: scale(0.88);
    }
    45% {
      opacity: 0.8;
      transform: scale(1.05);
    }
    55% {
      opacity: 1;
      transform: scale(1.12);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .gc,
    .gc__core,
    .gc__core-hot {
      animation: none !important;
    }
    .gc__core,
    .gc__core-hot {
      opacity: 0.85;
    }
  }
</style>

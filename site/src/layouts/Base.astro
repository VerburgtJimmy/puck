---
import '@fontsource-variable/fraunces/wght.css';
import '@fontsource/instrument-sans/400.css';
import '@fontsource/instrument-sans/500.css';
import '@fontsource/instrument-sans/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '../styles/tokens.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'puck - native tooling for PHP and Laravel',
  description = 'Native tooling for PHP and Laravel, starting with the install. Composer-compatible composer.json and lock, one static binary, a shared store.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://puck.jimmyverburgt.com/" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
